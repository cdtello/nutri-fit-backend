{
  "info": {
    "_postman_id": "c386af35-661a-4e6e-8f7b-5f5f0615cd10",
    "name": "NutriFit API",
    "description": "Coleccion organizada por modulos. Cree un usuario primero y actualice la variable userId con el ID que devuelva la respuesta.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "userId",
      "value": "1234567890"
    }
  ],
  "item": [
    {
      "name": "Users",
      "description": "Modulo de usuarios. Ejecute Crear usuario y luego actualice userId antes de usar las rutas con ID.",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"1234567890\",\n  \"name\": \"Usuario de prueba\",\n  \"email\": \"prueba@nutrifit.local\",\n  \"age\": 25,\n  \"phone\": \"+573101234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Consultar usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Usuario de prueba actualizado\",\n  \"age\": 26\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        },
        {
          "name": "Desactivar usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/users/{{userId}}"
          }
        }
      ]
    }
  ]
}
